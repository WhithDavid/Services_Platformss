/* pages/cir/cir.wxss */
.top_navigation{
width: 100%;
height: 200rpx;
background-color:aqua;
display: flex;/*设置flex模式*/
flex-direction:row;/*设置主轴为纵*/
justify-content:left;/*设置主轴分布为平均分布*/
align-items:center;/*设置侧轴分布为中心分布*/
}

.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 170rpx;  /* 根据设计调整 */
  background-color: #ffffff00;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  z-index: 999;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #561391;
  border-radius: 48rpx;
  padding: 0 20rpx;
  height: 68rpx;
}

.search-icon {
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  height: 64rpx;
}

.search-btn {
  background-color: #07c160;
  color: white;
  border-radius: 40rpx;
  margin-left: 20rpx;
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
}

.page-content {
  margin-top: 108rpx;  /* 避开固定定位的搜索栏 */
}
.user{
  height: 180rpx;
  width: 96%;
  background-color: aquamarine;
  margin: 0 auto;
  z-index: 1;
  margin-top: -230rpx;
  position: relative;
  display: flex;/*设置flex模式*/
  flex-direction:row;/*设置主轴为纵*/
  justify-content:flex-start;/*设置主轴分布为平均分布*/
  align-items:center;/*设置侧轴分布为中心分布*/
}
.main{
  position: relative;
  z-index: 2;
  display: flex;/*设置flex模式*/
  flex-direction: column;/*设置主轴为纵*/
  justify-content:flex-start;/*设置主轴分布为平均分布*/
  align-items: center;/*设置侧轴分布为中心分布*/
  width: 100%;
  height: 260rpx;
  /* height: max-content; */
  border-top-left-radius: 25px; /*左上角圆角*/
  border-top-right-radius: 25px; /*右上角圆角 */
  /* background-color:white; */
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.8), rgba(255, 255, 255,  1));
  /* margin-top: -150rpx; */
  
}
