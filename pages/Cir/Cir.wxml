<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="brand-row">
      <view>
        <view class="eyebrow">CAMPUS COMMUNITY</view>
        <view class="brand">校园生活圈</view>
        <view class="brand-subtitle">发现身边的新鲜事</view>
      </view>
      <view class="brand-mark">
        <view class="brand-mark-dot"></view>
      </view>
    </view>
    <view class="search-bar">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索帖子、二手、失物、评分" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
      <button class="search-btn" size="mini" bindtap="onSearch">搜索</button>
    </view>
  </view>

  <view class="category-sticky-wrap" style="top: 0; padding-top: {{statusBarHeight}}px;">
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="category-list">
        <view class="{{index === handle_navigation_index ? 'category-item active' : 'category-item'}}" wx:for="{{handle_navigation}}" wx:key="index" data-nid="{{index}}" bindtap="clic">
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="notice-bar">
    <view class="notice-label"><view class="notice-dot"></view>校园公告</view>
    <swiper circular autoplay interval="3500" class="notice-swiper">
      <swiper-item wx:for="{{notice_text}}" wx:key="index">
        <text>{{item}}</text>
      </swiper-item>
    </swiper>
    <view class="notice-arrow">›</view>
  </view>

  <view class="task-section">
    <view class="section-head task-section-head">
      <view>
        <view class="section-title">悬赏任务</view>
        <view class="section-subtitle">代拿、代取任务在这里接单</view>
      </view>
      <view class="task-more">全部任务 <text>›</text></view>
    </view>
    <scroll-view class="task-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="task-list">
        <view class="task-card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="toTaskDetail">
          <view class="task-top">
            <view class="task-type"><view class="task-type-dot"></view>{{item.category}}</view>
            <view class="task-status"><view></view>{{item.status}}</view>
          </view>
          <view class="task-title">{{item.title}}</view>
          <view class="task-route">{{item.location}}</view>
          <view class="task-bottom">
            <view><text class="task-price">￥{{item.reward}}</text><text class="task-reward-label">悬赏</text></view>
            <view class="task-deadline">{{item.deadline}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">校园新鲜事</view>
      <view class="section-subtitle">{{handle_navigation[handle_navigation_index]}} · 看看同学们都在分享什么</view>
    </view>
    <view class="post-count">{{posts.length}} 条</view>
  </view>

  <view class="post-list">
    <view wx:if="{{initialLoading && !hasLoadedOnce}}" class="empty">
      <view class="empty-icon loading-icon"><view></view></view>
      <view class="empty-title">正在加载帖子</view>
      <view class="empty-subtitle">先为你准备前 15 条内容</view>
    </view>
    <view wx:elif="{{posts.length === 0}}" class="empty">
      <view class="empty-icon"><view></view></view>
      <view class="empty-title">暂时没有相关内容</view>
      <view class="empty-subtitle">换个关键词或分类试试看</view>
    </view>
    <view class="post-card type-{{item.type}}" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="toPostDetail">
      <view class="post-head">
        <view class="avatar-wrap" data-openid="{{item.userOpenid}}" catchtap="toUserProfile">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="online-dot"></view>
        </view>
        <view class="author-box">
          <view class="author">{{item.author}}</view>
          <view class="time">{{item.createdAt}} · 来自校园</view>
        </view>
        <view class="tag">{{item.category}}</view>
      </view>

      <view class="title">{{item.title}}</view>
      <view class="content-text">{{item.content}}</view>

      <view wx:if="{{item.mediaFiles && item.mediaFiles.length}}" class="post-images">
        <view
          wx:for="{{item.mediaFiles}}"
          wx:for-item="media"
          wx:key="index"
          class="post-media-item"
          catchtap="noop"
        >
          <image
            wx:if="{{media.type === 'image'}}"
            class="post-image"
            src="{{media.url}}"
            mode="aspectFill"
            data-src="{{media.url}}"
            data-images="{{item.images}}"
            catchtap="previewPostImage"
          ></image>
          <view wx:else class="post-video-wrap">
            <video
              class="post-video"
              src="{{media.url}}"
              object-fit="cover"
              poster="{{media.poster || ''}}"
              controls="{{true}}"
              show-center-play-btn="{{true}}"
              enable-progress-gesture="{{true}}"
            ></video>
            <view class="post-video-badge">视频</view>
          </view>
        </view>
      </view>

      <view class="meta-row">
        <text class="highlight" wx:if="{{item.price}}">￥{{item.price}}</text>
        <text class="highlight" wx:if="{{item.score}}">评分 {{item.score}}</text>
        <text class="status"><text class="status-dot"></text>{{item.status}}</text>
      </view>

      <view class="actions">
        <view class="action-view"><image src="/pages/images/watch.png"></image>{{item.views}}</view>
        <view><image src="/pages/images/comment.png"></image>{{item.comments}}</view>
        <view
          class="{{item.isLiked ? 'liked-action' : ''}}"
          data-id="{{item.id}}"
          catchtap="togglePostLike"
        ><image src="/pages/images/like.png"></image>{{item.likes}}</view>
        <view class="detail-link">查看详情 <text>›</text></view>
      </view>
    </view>

    <view wx:if="{{posts.length > 0 && loadingMore}}" class="load-more">正在加载更多帖子...</view>
    <view wx:elif="{{posts.length > 0 && !hasMorePosts}}" class="load-more load-more-end">已经到底了</view>
  </view>
</view>
