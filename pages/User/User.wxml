<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-title">我的</view>

    <view class="profile">
      <view class="avatar-block">
        <view class="avatar-wrap" bindtap="onProfileTap">
          <image class="avatar" src="{{userInfo ? userInfo.user_icon : unLoginUrl}}" mode="aspectFill"></image>
          <view class="{{userInfo ? 'avatar-status online' : 'avatar-status'}}"></view>
        </view>

        <view class="follow-row">
          <view class="follow-item">
            <view class="follow-count">{{userInfo ? followStats.following : '--'}}</view>
            <view class="follow-label">关注</view>
          </view>
          <view class="follow-divider">|</view>
          <view class="follow-item">
            <view class="follow-count">{{userInfo ? followStats.fans : '--'}}</view>
            <view class="follow-label">粉丝</view>
          </view>
        </view>
      </view>

      <view class="profile-main">
        <view class="name-row">
          <view class="name">{{userInfo ? userInfo.user_name : '登录账号'}}</view>
          <view wx:if="{{userInfo}}" class="identity">{{userInfo.studentTag}}</view>
        </view>
        <view class="desc" catchtap="editBio">
          {{userInfo ? (userInfo.user_bio || '点击添加个人简介') : '登录后查看个人内容和悬赏任务'}}
        </view>
      </view>

      <view class="profile-arrow" bindtap="onProfileTap">›</view>
    </view>

    <view class="hero-decoration decoration-one"></view>
    <view class="hero-decoration decoration-two"></view>
  </view>

  <view class="content-card task-card">
    <view
      class="task-item"
      wx:for="{{taskEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTaskTap"
    >
      <view class="task-icon">{{item.icon}}</view>
      <view class="task-count">{{userInfo ? item.count : '--'}}</view>
      <view class="task-label">{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">我的内容</view>
        <view class="section-subtitle">点击不同内容切换下方列表</view>
      </view>
      <view class="section-more">可切换</view>
    </view>

    <view class="content-card content-list-card">
      <view class="content-switch-row">
        <view
          wx:for="{{contentTabs}}"
          wx:key="key"
          class="content-switch-item {{activeContentTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onContentTabChange"
        >
          {{item.label}}
        </view>
      </view>

      <view class="content-panel">
        <block wx:if="{{!userInfo}}">
          <view class="empty-wrap">
            <view class="empty-title">登录后查看个人内容</view>
            <view class="empty-desc">帖子、点赞和浏览记录会在这里统一展示</view>
          </view>
        </block>

        <block wx:elif="{{contentLoading}}">
          <view class="empty-wrap">
            <view class="empty-title">正在加载内容</view>
            <view class="empty-desc">稍等一下，马上就好</view>
          </view>
        </block>

        <block wx:elif="{{displayContentList.length}}">
          <view
            wx:for="{{displayContentList}}"
            wx:key="id"
            class="list-row"
            data-id="{{item.id}}"
            bindtap="onContentItemTap"
          >
            <view class="list-mark">{{activeContentMark}}</view>
            <view class="list-main">
              <view class="list-head">
                <view class="list-title">{{item.title}}</view>
                <view wx:if="{{activeContentTab === 'posts'}}" class="post-tools" catchtap="closePostMenu">
                  <view class="status-tag {{item.statusClassName}}">{{item.statusLabel}}</view>
                  <view
                    class="more-btn"
                    data-id="{{item.id}}"
                    catchtap="togglePostMenu"
                  >•••</view>

                  <view wx:if="{{activeManagePostId === item.id}}" class="post-menu">
                    <view
                      class="menu-item"
                      data-id="{{item.id}}"
                      data-action="public"
                      catchtap="onManagePostAction"
                    >设为公开</view>
                    <view
                      class="menu-item"
                      data-id="{{item.id}}"
                      data-action="private"
                      catchtap="onManagePostAction"
                    >仅自己可见</view>
                    <view
                      class="menu-item danger"
                      data-id="{{item.id}}"
                      data-action="delete"
                      catchtap="onManagePostAction"
                    >删除帖子</view>
                  </view>
                </view>
              </view>
              <view class="list-desc">{{item.desc}}</view>
              <view class="list-stats">
                <view class="list-stat">点赞 {{item.likes}}</view>
                <view class="list-stat">评论 {{item.comments}}</view>
                <view class="list-stat">浏览 {{item.views}}</view>
              </view>
            </view>
          </view>
        </block>

        <block wx:else>
          <view class="empty-wrap">
            <view class="empty-title">还没有相关内容</view>
            <view class="empty-desc">等你发布、点赞或浏览后，这里就会出现记录</view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view wx:if="{{showDeleteConfirm}}" class="modal-mask" catchtap="cancelDeletePost">
    <view class="modal-card" catchtap="closePostMenu">
      <view class="modal-body">
        <view class="modal-title">删除帖子</view>
        <view class="modal-text">删除帖子之后将无法恢复，是否继续</view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn" catchtap="cancelDeletePost">取消</view>
        <view class="modal-btn danger" catchtap="confirmDeletePost">继续删除</view>
      </view>
    </view>
  </view>

  <view class="version">校园生活圈 · 让校园生活更简单</view>
</view>
