<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-title">我的</view>

    <view class="profile"  >
      <view class="avatar-wrap" bindtap="onProfileTap">
        <image class="avatar" src="{{userInfo ? userInfo.user_icon : unLoginUrl}}" mode="aspectFill"></image>
        <view class="{{userInfo ? 'avatar-status online' : 'avatar-status'}}"></view>
      </view>
 
      <view class="profile-main">
        <view class="name-row">
          <view class="name">{{userInfo ? userInfo.user_name : '登录账号'}}</view>
          <view wx:if="{{userInfo}}" class="identity">{{userInfo.studentTag}}</view>
        </view>
        <view class="desc" catchtap="editBio">
          {{userInfo ? (userInfo.user_bio || '点击添加个人简介') : '登录后管理帖子、收藏和悬赏任务'}}
        </view>
      </view>

      <view class="profile-arrow" bindtap="onProfileTap">›</view>
    </view>

    <view class="hero-decoration decoration-one"></view>
    <view class="hero-decoration decoration-two"></view>
  </view>

  <view class="content-card overview-card">
    <view
      class="overview-item"
      wx:for="{{contentEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onEntryTap"
    >
      <view class="overview-count">{{userInfo ? item.count : '--'}}</view>
      <view class="overview-label">{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">悬赏任务</view>
        <view class="section-subtitle">发布与接取的任务分开管理</view>
      </view>
      <view class="section-more" data-key="published" bindtap="onEntryTap">全部 <text>›</text></view>
    </view>

    <view class="content-card task-grid">
      <view
        class="task-item"
        wx:for="{{taskEntries}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onEntryTap"
      >
        <view class="task-icon">{{item.icon}}</view>
        <view class="task-count">{{userInfo ? item.count : '--'}}</view>
        <view class="task-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">常用功能</view>
        <view class="section-subtitle">账号与服务设置</view>
      </view>
    </view>

    <view class="content-card service-card">
      <view class="service-row" bindtap="toDetail">
        <view class="service-icon orange">资</view>
        <view class="service-name">个人资料</view>
        <view class="service-desc">{{userInfo ? '编辑' : '登录后设置'}}</view>
        <view class="service-arrow">›</view>
      </view>

      <button class="service-row service-button" open-type="contact">
        <view class="service-icon green">客</view>
        <view class="service-name">在线客服</view>
        <view class="service-desc">问题咨询</view>
        <view class="service-arrow">›</view>
      </button>

      <button class="service-row service-button" open-type="openSetting">
        <view class="service-icon blue">权</view>
        <view class="service-name">授权设置</view>
        <view class="service-desc">隐私与权限</view>
        <view class="service-arrow">›</view>
      </button>

      <button class="service-row service-button last" open-type="feedback">
        <view class="service-icon pink">议</view>
        <view class="service-name">投诉建议</view>
        <view class="service-desc">帮助我们改进</view>
        <view class="service-arrow">›</view>
      </button>
    </view>
  </view>

  <button wx:if="{{userInfo}}" class="logout-btn" bindtap="outLogin">退出登录</button>
  <view class="version">校园生活圈 · 让校园生活更简单</view>
</view>
