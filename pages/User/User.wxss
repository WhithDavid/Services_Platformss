page {
  background: #f7f7f8;
  color: #282528;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 100rpx;
  background: linear-gradient(145deg, #f8c79f 0%, #f2a978 100%);
  border-radius: 0 0 42rpx 42rpx;
}

.nav-title {
  position: relative;
  z-index: 2;
  height: 88rpx;
  line-height: 88rpx;
  color: #25211f;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.profile {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  padding: 24rpx 6rpx 12rpx;
}

.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 10rpx 24rpx rgba(105, 66, 41, 0.13);
}

.avatar-status {
  position: absolute;
  right: 2rpx;
  bottom: 4rpx;
  width: 17rpx;
  height: 17rpx;
  border: 5rpx solid #f4b583;
  border-radius: 50%;
  background: #aaa19b;
}

.avatar-status.online {
  background: #47c982;
}

.follow-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.follow-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 52rpx;
}

.follow-count {
  color: #474246;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.follow-label {
  margin-top: 6rpx;
  color: #615c60;
  font-size: 18rpx;
  line-height: 1;
}

.follow-divider {
  margin-top: -4rpx;
  color: #726d71;
  font-size: 20rpx;
  line-height: 1;
}

.profile-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.name {
  color: #282321;
  font-size: 34rpx;
  font-weight: 700;
}

.identity {
  margin-left: 12rpx;
  padding: 5rpx 10rpx;
  color: #75533c;
  font-size: 18rpx;
  background: rgba(255, 255, 255, 0.48);
  border-radius: 999rpx;
}

.desc {
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(54, 44, 38, 0.67);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-arrow {
  flex-shrink: 0;
  padding: 20rpx 4rpx 20rpx 22rpx;
  color: rgba(49, 41, 37, 0.65);
  font-size: 40rpx;
}

.hero-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.decoration-one {
  top: -120rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
}

.decoration-two {
  right: 120rpx;
  bottom: 28rpx;
  width: 100rpx;
  height: 100rpx;
}

.content-card {
  margin-left: 24rpx;
  margin-right: 24rpx;
  background: #fff;
  border: 1rpx solid #e8e5e7;
  border-radius: 26rpx;
  box-shadow: 0 9rpx 24rpx rgba(56, 46, 51, 0.045);
}

.task-card {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: -62rpx;
  padding: 28rpx 12rpx 27rpx;
}

.task-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.task-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  color: #7a563d;
  font-size: 25rpx;
  font-weight: 700;
  background: #fff0e4;
  border-radius: 22rpx;
}

.task-count {
  position: absolute;
  top: -8rpx;
  right: 17rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 17rpx;
  line-height: 30rpx;
  text-align: center;
  background: #ee7658;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
}

.task-label {
  margin-top: 12rpx;
  color: #5f595d;
  font-size: 21rpx;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 29rpx 17rpx;
}

.section-title {
  color: #2a2629;
  font-size: 31rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #a09a9e;
  font-size: 21rpx;
}

.section-more {
  padding-bottom: 2rpx;
  color: #777176;
  font-size: 21rpx;
}

.content-list-card {
  padding: 18rpx 16rpx 10rpx;
}

.content-switch-row {
  display: flex;
  align-items: flex-end;
  gap: 40rpx;
  padding: 0 10rpx 2rpx;
}

.content-switch-item {
  position: relative;
  padding-bottom: 10rpx;
  color: #9e989c;
  font-size: 24rpx;
  font-weight: 500;
}

.content-switch-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: transparent;
}

.content-switch-item.active {
  color: #222222;
  font-weight: 700;
}

.content-switch-item.active::after {
  background: #222222;
}

.content-panel {
  margin-top: 18rpx;
  border-top: 1rpx solid #efedef;
}

.list-row {
  display: flex;
  align-items: center;
  min-height: 176rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f1eef0;
  position: relative;
}

.list-row:last-child {
  border-bottom: 0;
}

.list-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  margin-right: 24rpx;
  color: #6c5444;
  font-size: 26rpx;
  font-weight: 700;
  background: #fff0e4;
  border-radius: 22rpx;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.list-title {
  flex: 1;
  overflow: hidden;
  color: #383337;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-tools {
  position: relative;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 86rpx;
  height: 42rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  color: #6d6669;
  font-size: 20rpx;
  background: #f3f0f1;
  border-radius: 999rpx;
}

.status-tag.public {
  color: #4f6b59;
  background: #edf7ef;
}

.status-tag.private {
  color: #8a7047;
  background: #fbf2e5;
}

.more-btn {
  min-width: 40rpx;
  color: #8b8589;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.post-menu {
  position: absolute;
  top: 50rpx;
  right: 0;
  width: 190rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #ece8ea;
  border-radius: 18rpx;
  box-shadow: 0 16rpx 32rpx rgba(32, 25, 28, 0.08);
  z-index: 8;
}

.menu-item {
  padding: 20rpx 24rpx;
  color: #3a3538;
  font-size: 24rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #f3eff1;
}

.menu-item.danger {
  color: #cf6666;
}


.list-desc {
  margin-top: 8rpx;
  color: #aaa4a8;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 12rpx;
  color: #8f888d;
  font-size: 21rpx;
}

.list-stat {
  white-space: nowrap;
}

.empty-wrap {
  padding: 64rpx 20rpx 56rpx;
  text-align: center;
}

.empty-title {
  color: #5d585b;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 10rpx;
  color: #9f999d;
  font-size: 22rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(22, 18, 20, 0.34);
  z-index: 20;
}

.modal-card {
  width: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(25, 20, 22, 0.15);
}

.modal-body {
  padding: 42rpx 36rpx 30rpx;
  text-align: center;
}

.modal-title {
  color: #2b2629;
  font-size: 32rpx;
  font-weight: 700;
}

.modal-text {
  margin-top: 14rpx;
  color: #7f787c;
  font-size: 24rpx;
  line-height: 1.7;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #f0ecee;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  color: #5f595d;
  font-size: 28rpx;
  line-height: 96rpx;
  text-align: center;
}

.modal-btn + .modal-btn {
  border-left: 1rpx solid #f0ecee;
}

.modal-btn.danger {
  color: #cf6666;
  font-weight: 600;
}

.version {
  padding: 30rpx 0 12rpx;
  color: #b8b2b6;
  font-size: 19rpx;
  text-align: center;
}
