.hand_img{
  height: 250rpx;
  width: 100%;
  display: flex;
  background-color: rgba(255, 255, 255, 0.8);
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  /* border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx; */
}
.hand{
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx; 
  width: 100%;
  padding: 0;
  background-color: rgba(255, 255, 255, 0.91);
  /* border: rgba(0, 0, 0, 0); */
  /* border-radius: 50%; */
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
}
.hand_name{
  width: 100%;
  height: 55rpx;
  background-color: rgba(255, 255, 255, 0.91);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgb(49, 49, 49);
  /* margin-bottom:50rpx; */
}
.list{
  width: 94%;
  height: 150rpx;
  background-color: rgba(197, 23, 23, 0.8);
  border-radius: 20rpx;
  display: flex;
  margin-left: 3%;
  justify-content:space-around;
  align-items: center;
}
.list_1{
  width: 90%;
  height: 80%;
  background-color: rgba(151, 117, 117, 0.8);
  display: flex;
  justify-content:space-between;
  align-items: center;
}
.list_content{
  width: 15%;
  height: 100%;
  border: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  background-color:rgba(151, 217, 217, 0.8);

}
.back_img{
  height: 100vh; 
  width: 100%; 
  z-index: -100;
   opacity: 1; 
   position: fixed;
}
.back_img image{
  width: 100%;
  height: 100%;
}