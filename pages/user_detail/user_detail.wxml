<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav">
      <view class="nav-btn" bindtap="onBack">‹</view>
      <view class="nav-title">个人资料</view>
      <view class="nav-btn nav-placeholder"></view>
    </view>

    <view class="profile">
      <image class="avatar" src="{{profile.user_icon}}" mode="aspectFill"></image>
      <view class="name">{{profile.user_name}}</view>
      <view class="tip">完善基本信息，让别人更容易认识你</view>
      <view class="edit-avatar" bindtap="onChooseAvatar">更换头像</view>
    </view>
  </view>

  <view class="content">
    <view class="card">
      <view class="row">
        <view class="label">昵称</view>
        <input
          class="input"
          placeholder="请输入昵称"
          maxlength="12"
          value="{{profile.user_name}}"
          data-field="user_name"
          bindinput="onInputChange"
        />
      </view>

      <view class="row">
        <view class="label">性别</view>
        <picker class="picker" mode="selector" range="{{genderOptions}}" bindchange="onGenderChange">
          <view class="picker-value">{{profile.user_gender}}</view>
        </picker>
      </view>

      <view class="row row-textarea">
        <view class="label">简介</view>
        <textarea
          class="textarea"
          placeholder="介绍一下自己"
          maxlength="50"
          value="{{profile.user_bio}}"
          data-field="user_bio"
          bindinput="onInputChange"
        ></textarea>
      </view>

      <view class="row">
        <view class="label">院系专业</view>
        <input
          class="input"
          placeholder="请输入院系专业"
          maxlength="24"
          value="{{profile.user_major}}"
          data-field="user_major"
          bindinput="onInputChange"
        />
      </view>

      <view class="row">
        <view class="label">校区</view>
        <picker class="picker" mode="selector" range="{{campusOptions}}" bindchange="onCampusChange">
          <view class="picker-value">{{profile.user_campus}}</view>
        </picker>
      </view>
    </view>

    <button class="save-btn" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
    <view class="subtip">当前先保存到本地缓存，后面可以再接云数据库</view>
  </view>
</view>
