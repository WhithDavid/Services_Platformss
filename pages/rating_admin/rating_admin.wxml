<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;"><view class="nav-btn" bindtap="onBack">‹</view><view class="nav-title">评分对象审核</view><view class="nav-placeholder"></view></view>
  <view class="intro">新创建的评分对象会先进入这里，审核通过后才会在校园评分中公开。</view>
  <view wx:if="{{loading}}" class="empty">正在加载待审核内容</view>
  <view wx:elif="{{!subjects.length}}" class="empty">暂时没有待审核对象</view>
  <view wx:else class="list"><view class="card" wx:for="{{subjects}}" wx:key="_id"><view class="name">{{item.name}}</view><view class="meta">{{item.category}}<text wx:if="{{item.location}}"> · {{item.location}}</text></view><view class="desc">{{item.description || '暂无简介'}}</view><view class="creator">提交人：{{item.created_by_name}}</view><view class="actions"><button class="reject" data-id="{{item._id}}" data-status="rejected" bindtap="review">驳回</button><button class="approve" data-id="{{item._id}}" data-status="approved" bindtap="review">通过审核</button></view></view></view>
</view>
