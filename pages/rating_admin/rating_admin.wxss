.page { min-height: 100vh; background: #f8f6f5; color: #332e31; }.nav { box-sizing: border-box; height: 120rpx; padding-left: 28rpx; padding-right: 28rpx; display:flex; align-items:center; justify-content:space-between; background: linear-gradient(145deg,#f7c096,#ee947a); border-radius:0 0 30rpx 30rpx; }.nav-btn,.nav-placeholder { width:62rpx; height:62rpx; }.nav-btn { display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.3); font-size:48rpx; }.nav-title { font-size:34rpx; font-weight:700; }.intro { margin:28rpx; padding:20rpx; border-radius:18rpx; background:#fff4ed; color:#a66e61; font-size:23rpx; line-height:1.5; }.list { padding:0 26rpx; }.card { margin-bottom:20rpx; padding:24rpx; border-radius:22rpx; background:#fff; box-shadow:0 8rpx 22rpx rgba(73,55,58,.06); }.name { font-size:30rpx; font-weight:700; }.meta,.creator { margin-top:8rpx; color:#9d8d8c; font-size:21rpx; }.desc { margin-top:16rpx; color:#65595a; font-size:24rpx; line-height:1.5; }.actions { display:flex; justify-content:flex-end; gap:14rpx; margin-top:22rpx; }.actions button { margin:0; padding:0 26rpx; height:66rpx; line-height:66rpx; border-radius:14rpx; font-size:23rpx; }.reject { background:#f2eeee; color:#867878; }.approve { background:#302a2d; color:#fff; }.empty { padding:160rpx 30rpx; text-align:center; color:#a69b9a; font-size:24rpx; }
