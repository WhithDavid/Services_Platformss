.page { min-height: 100vh; background: #f8f6f5; color: #332e31; padding-bottom: 60rpx; }
.hero { background: linear-gradient(145deg, #f7c096 0%, #f4a77e 65%, #ee947a 100%); border-radius: 0 0 38rpx 38rpx; padding-bottom: 30rpx; }
.nav { height: 88rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 28rpx; }
.nav-btn { width: 62rpx; height: 62rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #44373a; background: rgba(255,255,255,.24); }
.add-btn { font-size: 40rpx; }
.nav-actions { display: flex; align-items: center; gap: 12rpx; }.admin-btn { padding: 12rpx 14rpx; border-radius: 18rpx; background: rgba(255,255,255,.48); color: #6b4d4a; font-size: 21rpx; }
.nav-title { font-size: 34rpx; font-weight: 700; }
.hero-copy { padding: 22rpx 42rpx 28rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 4rpx; color: rgba(70,48,46,.62); }
.hero-title { margin-top: 8rpx; font-size: 52rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-subtitle { margin-top: 8rpx; font-size: 24rpx; color: #634e4e; }
.search-bar { height: 78rpx; margin: 0 28rpx; padding: 0 12rpx 0 26rpx; border-radius: 22rpx; display: flex; align-items: center; background: rgba(255,255,255,.72); }
.search-icon { width: 24rpx; height: 24rpx; border: 3rpx solid #7d6765; border-radius: 50%; margin-right: 16rpx; position: relative; }
.search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; background: #7d6765; right: -8rpx; bottom: -4rpx; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; font-size: 24rpx; }
.search-btn { margin: 0; border-radius: 16rpx; background: #302a2d; color: #fff; line-height: 58rpx; height: 58rpx; }
.category-scroll { white-space: nowrap; padding: 24rpx 0 4rpx; }
.category-list, .form-category-list { display: flex; padding: 0 28rpx; gap: 16rpx; }
.category-pill { flex-shrink: 0; padding: 14rpx 24rpx; background: #fff; border-radius: 40rpx; color: #8d8282; font-size: 23rpx; }
.category-pill.active { background: #ee8b68; color: #fff; box-shadow: 0 8rpx 18rpx rgba(238,139,104,.22); }
.section-head { display: flex; justify-content: space-between; align-items: end; padding: 34rpx 32rpx 18rpx; }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-subtitle, .count-label { color: #9c9191; font-size: 22rpx; margin-top: 6rpx; }
.subject-list { padding: 0 26rpx; }
.subject-card { display: flex; align-items: flex-start; padding: 24rpx; margin-bottom: 20rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(73,55,58,.06); }
.subject-icon { width: 78rpx; height: 78rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #f8d6ba; color: #b55d4e; font-size: 32rpx; font-weight: 700; }
.subject-main { flex: 1; min-width: 0; margin: 0 18rpx; }
.subject-title { font-size: 30rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.subject-meta { margin-top: 6rpx; color: #9d8d8c; font-size: 21rpx; }
.subject-desc { margin-top: 10rpx; color: #716767; font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.subject-quote { margin-top: 12rpx; padding: 8rpx 12rpx; border-radius: 10rpx; background: #fff5ef; color: #ad6d5c; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.score-box { min-width: 106rpx; text-align: right; }
.score { color: #e27d60; font-size: 44rpx; font-weight: 800; line-height: 1; }
.score-label { margin-top: 10rpx; color: #a79a99; font-size: 18rpx; white-space: nowrap; }
.empty { padding: 120rpx 40rpx; text-align: center; color: #aaa0a0; }
.empty-icon { width: 82rpx; height: 82rpx; margin: 0 auto 24rpx; border-radius: 50%; display:flex; align-items:center; justify-content:center; background:#f1d6c8; color:#d07a60; font-size:32rpx; }
.empty-title { color: #716767; font-size: 28rpx; }
.empty-subtitle { margin-top: 12rpx; font-size: 22rpx; }
.loading-dot { width: 44rpx; height: 44rpx; margin: 0 auto 24rpx; border: 5rpx solid #f0d4c7; border-top-color: #e78a69; border-radius: 50%; }
.modal-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(42,32,35,.42); }
.create-modal { width: 100%; max-height: 86vh; box-sizing: border-box; padding: 28rpx 30rpx 46rpx; border-radius: 34rpx 34rpx 0 0; background: #fffaf8; }
.modal-head { display: flex; justify-content: space-between; align-items: center; }
.modal-title { font-size: 34rpx; font-weight: 700; }
.modal-close { color: #9a8b8c; font-size: 46rpx; }
.modal-tip { margin: 10rpx 0 22rpx; color: #b27c70; font-size: 21rpx; }
.field-label { margin: 18rpx 0 8rpx; color: #635758; font-size: 23rpx; font-weight: 600; }
.field-label text { color: #dc725e; }
.field-input, .content-input { width: 100%; box-sizing: border-box; padding: 20rpx; border-radius: 14rpx; background: #f5f1f0; font-size: 24rpx; }
.content-input { min-height: 120rpx; margin-top: 16rpx; }
.form-category-scroll { white-space: nowrap; }
.form-category-list { padding: 0; gap: 12rpx; }
.form-category { flex-shrink: 0; padding: 12rpx 18rpx; border-radius: 28rpx; background: #f2eeee; color: #8c7e80; font-size: 21rpx; }
.form-category.active { background: #f0a083; color: #fff; }
.submit-btn { margin-top: 26rpx; border-radius: 18rpx; background: #302a2d; color: #fff; font-size: 28rpx; }
