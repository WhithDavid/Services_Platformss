<!-- 顶部自动识别高度防止手机遮挡 -->
<view style="height: {{statusBarHeight}}px;width: 100%;"></view>
<!-- 顶部详细标题 -->
<view style="height: 50rpx; width: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;">
  <!-- 返回按钮（靠左） -->
  <view style="height: 80%; width: 40rpx; position: absolute; left: 20rpx; display: flex; align-items: center; justify-content: center;">
    <image style="height: 90%; width: 90%;" src="/pages/images/return.png"></image>
  </view>
  <!-- 标题（完全居中） -->
  <view style="width: 100%; height: 50rpx; text-align: center; line-height: 50rpx; color: rgb(70, 70, 70); font-size: 29rpx; ">
    详情
  </view>
</view>
<view style="width: 100rpx;height: 50rpx;"></view>
<!-- 顶部详细标题 end -->

