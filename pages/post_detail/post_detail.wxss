page {
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
}

.nav {
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  position: relative;
}

.back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back image {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  position: absolute;
  left: 120rpx;
  right: 120rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.card,
.comment-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.author-box {
  flex: 1;
}

.author {
  font-size: 28rpx;
  font-weight: 700;
}

.time,
.comment-time {
  color: #999;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.tag {
  color: #e85b5b;
  background: #fff0f0;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
}

.title {
  margin-top: 26rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.content-text {
  margin-top: 18rpx;
  font-size: 29rpx;
  color: #444;
  line-height: 1.7;
}

.meta-row {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
  color: #e85b5b;
  font-size: 26rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-title {
  padding: 10rpx 28rpx;
  color: #555;
  font-size: 28rpx;
  font-weight: 700;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}

.comment-content {
  margin-top: 14rpx;
  color: #555;
  font-size: 27rpx;
  line-height: 1.6;
}
